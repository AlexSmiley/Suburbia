{
  "name": "suburbia-node-api",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Suburbia application: React frontend and TypeScript/Express API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run build:frontend && tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix ../frontend run dev",
    "build:frontend": "npm --prefix ../frontend install --include=dev --no-audit --no-fund && npm --prefix ../frontend run build",
    "build": "npm run build:frontend && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}