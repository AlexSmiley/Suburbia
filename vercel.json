{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "node-api": {
      "root": "node-api",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/postcodes",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/:state(ACT|NSW|NT|QLD|SA|TAS|VIC|WA)",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/:first([0-9]{1,10})/:second([0-9]{1,10})",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
